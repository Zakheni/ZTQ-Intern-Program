<odoo>
<record id="waste_invoice_company_rule" model="ir.rule">
    <field name="name">Waste Invoice Company</field>
    <field name="model_id" ref="zw_invoice.model_waste_invoice"/>
    <field name="domain_force">[('company_id','=',user.company_id.id)]</field>
    <field name="groups" eval="[(4, ref('zw_user.group_depot_admin')), (4, ref('zw_user.group_depot_manager'))]"/>
</record>

<record id="waste_invoice_finance_rule" model="ir.rule">
    <field name="name">Waste Invoice Finance</field>
    <field name="model_id" ref="zw_invoice.model_waste_invoice"/>
    <field name="domain_force">[('state','in',['posted','paid'])]</field>
    <field name="groups" eval="[(4, ref('zw_user.group_finance_admin')), (4, ref('zw_user.group_finance_manager'))]"/>
</record>

<record id="waste_invoice_line_company_rule" model="ir.rule">
    <field name="name">Waste Invoice Line Company</field>
    <field name="model_id" ref="zw_invoice.model_waste_invoice_line"/>
    <field name="domain_force">[('invoice_id.company_id','=',user.company_id.id)]</field>
    <field name="groups" eval="[(4, ref('zw_user.group_depot_admin')), (4, ref('zw_user.group_depot_manager'))]"/>
</record>

</odoo>