<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- View Definitions -->
        <record id="view_account_move_form_zw_invoice" model="ir.ui.view">
            <field name="name">account.move.form.zw_invoice</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="Zi-Waste Invoice Details">
                        <field name="manifest_id"/>
                        <field name="mine_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="state"/>
                    </group>
                </xpath>
<!--                <xpath expr="//div[@name='buttons']" position="inside">-->
<!--                    <button name="action_authorize" string="Authorize" type="object" class="oe_highlight" attrs="{'invisible': [('state', 'not in', ['draft', 'pro_forma'])]}"/>-->
<!--                    <button name="action_reject" string="Reject" type="object" attrs="{'invisible': [('state', 'not in', ['draft', 'pro_forma'])]}"/>-->
<!--                    <button name="action_fix" string="Fix" type="object" attrs="{'invisible': [('state', '=', 'posted')]}"/>-->
<!--                </xpath>-->
            </field>
        </record>
        <record id="view_account_move_tree_zw_invoice" model="ir.ui.view">
            <field name="name">account.move.tree.zw_invoice</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="manifest_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="action_invoice" model="ir.actions.act_window">
            <field name="name">Invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_account_move_tree_zw_invoice"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create your first invoice</p>
            </field>
        </record>

        <menuitem id="menu_zw_invoice_management_root" name="Waste Invoice Management" sequence="80" groups="zw_user.group_finance_admin"/>
        <menuitem id="menu_zw_invoice_management_invoices" name="Invoices" parent="menu_zw_invoice_management_root" action="action_invoice" groups="zw_user.group_finance_admin"/>
    </data>
</odoo>