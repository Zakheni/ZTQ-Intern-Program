<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_form_zw_invoice" model="ir.ui.view">
        <field name="name">account.move.form.zw_invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Zi-Waste Invoice Details">
                    <field name="manifest_id"/>
                    <field name="mine_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <div attrs="{'invisible': [('state', 'not in', ['pro_forma', 'rejected'])]}">
                    <button name="action_authorize" string="Authorize" type="object" class="oe_highlight"/>
                    <button name="action_reject" string="Reject" type="object"/>
                    <button name="action_fix" string="Fix" type="object" attrs="{'invisible': [('state', '!=', 'rejected')]}"/>
                </div>
            </xpath>
        </field>
    </record>
    <record id="view_account_move_tree_zw_invoice" model="ir.ui.view">
        <field name="name">account.move.tree.zw_invoice</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mine_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="amount_total"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>
