<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="sequence_purchase_order_zi" model="ir.sequence">
            <field name="name">Zi-Waste Purchase Order Number</field>
            <field name="code">purchase.order.zi</field>
            <field name="prefix">PO-ZI/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
            <field name="implementation">standard</field>
            <field name="use_date_range">False</field>
            <field name="active">True</field>
        </record>


        <record id="sequence_purchase_order_vendor" model="ir.sequence">
            <field name="name">Zi-Waste Vendor Number</field>
            <field name="code">purchase.order.vendor</field>
            <field name="prefix">VEND/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
            <field name="implementation">standard</field>
            <field name="use_date_range">False</field>
            <field name="active">True</field>
        </record>


        <record id="sequence_mine_mine_id" model="ir.sequence">
            <field name="name">Mine ID Sequence</field>
            <field name="code">mine.mine.id</field>
            <field name="prefix">MID-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
        </record>

        <record id="sequence_mine_mine_code" model="ir.sequence">
            <field name="name">Mine Code Sequence</field>
            <field name="code">mine.mine</field>
            <field name="prefix">MCODE-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next_actual">1</field>
        </record>
    </data>
</odoo>