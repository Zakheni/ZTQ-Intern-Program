<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_res_partner_form_zw_customer" model="ir.ui.view">
            <field name="name">res.partner.form.zw_customer</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <form string="Customer">
                    <sheet>
                        <group>
                            <field name="vat_number"/>
                            <field name="bank_name"/>
                            <field name="branch_code"/>
                            <field name="account_number"/>
                            <field name="account_type"/>
                            <field name="contact_person_position"/>
                            <field name="second_phone"/>
                            <field name="fax_number"/>
                            <field name="mine_ids"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_res_partner_tree_zw_customer" model="ir.ui.view">
            <field name="name">res.partner.tree.zw_customer</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="vat_number"/>
                    <field name="bank_name"/>
                </tree>
            </field>
        </record>

        <record id="action_zw_customer" model="ir.actions.act_window">
            <field name="name">Customers</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_res_partner_tree_zw_customer"/>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create your first customer</p>
            </field>
        </record>

        <menuitem id="menu_zw_customer_root" name="Waste Customer Management" sequence="20" groups="zw_user.group_depot_admin"/>
        <menuitem id="menu_zw_customer_customers" name="Customers" parent="menu_zw_customer_root" action="action_zw_customer" groups="zw_user.group_depot_admin"/>
    </data>
</odoo>