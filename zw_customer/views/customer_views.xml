<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom Tree View (Customers) -->
    <record id="zw_customer_res_partner_tree" model="ir.ui.view">
        <field name="name">res.partner.tree.zw_customer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" eval="False"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <tree string="Customers">
                <field name="name"/>
                <field name="vat_number"/>
                <field name="phone"/>
                <field name="email"/>
            </tree>
        </field>
    </record>


    <record id="zw_customer_res_partner_form" model="ir.ui.view">
        <field name="name">zw_customer.res_partner_form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" eval="False"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <group>

                        <field name="name"/>
                        <field name="vat_number" required="1"/>
                        <field name="bank_name"/>
                        <field name="branch_code"/>
                        <field name="account_number"/>
                        <field name="account_type"/>
                        <field name="contact_person_position"/>
                        <field name="phone" attrs="{'invisible': [('vat_number', '=', False)]}"/>
                        <field name="second_phone"/>
                        <field name="fax_number"/>
                        <field name="email" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_waste_customers" model="ir.actions.act_window">
        <field name="name">Waste Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('vat_number', '!=', False)]</field>
        <field name="context">
            {"search_default_customer": 1, "default_customer_rank": 1}
        </field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create your first customer</p>
        </field>
    </record>


    <record id="action_waste_customers_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="zw_customer_res_partner_tree"/>
        <field name="act_window_id" ref="action_waste_customers"/>
    </record>

    <record id="action_waste_customers_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="zw_customer_res_partner_form"/>
        <field name="act_window_id" ref="action_waste_customers"/>
    </record>


    <menuitem id="menu_customers_root" name="Waste Customers" sequence="10"/>
    <menuitem id="menu_waste_customers" name="Waste Customers" action="action_waste_customers" parent="menu_customers_root"/>
</odoo>