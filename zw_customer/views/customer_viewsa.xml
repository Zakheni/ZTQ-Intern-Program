<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_zw_customer" model="ir.ui.view">
        <field name="name">res.partner.form.zw_customer</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Zi-Waste Customer Details">
                    <field name="vat_number"/>
                    <field name="bank_name"/>
                    <field name="branch_code"/>
                    <field name="account_number"/>
                    <field name="account_type"/>
                    <field name="contact_person_position"/>
                    <field name="second_phone"/>
                    <field name="fax_number"/>
                    <field name="mine_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_partner_tree_zw_customer" model="ir.ui.view">
        <field name="name">res.partner.tree.zw_customer</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="vat_number"/>
                <field name="phone"/>
                <field name="email"/>
            </tree>
        </field>
    </record>
</odoo>