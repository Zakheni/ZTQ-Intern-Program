<odoo>
    <data>

        <record id="stock_quant_form_zw_asset" model="ir.ui.view">
            <field name="name">stock.quant.form.zw_asset</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <form string="Zi-Waste Bins">
                    <sheet>
                        <group>
                            <field name="product_id"/>
                            <field name="bin_number"/>







                            <field name="waste_description"/>
                            <field name="mine_id"/>
                            <field name="condition"/>
                            <field name="bin_type"/>
                            <field name="location"/>
                        </group>
                        <notebook>
                            <page string="Audits">
                                <field name="audit_ids" widget="one2many_list">
                                    <tree>
                                        <field name="month_year"/>
                                        <field name="mine_id"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for stock.quant -->
        <record id="stock_quant_tree_zw_asset" model="ir.ui.view">
            <field name="name">stock.quant.tree.zw_asset</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <tree string="Zi-Waste Bins">
                    <field name="bin_number"/>
                    <field name="waste_type"/>
                    <field name="mine_id"/>
                    <field name="condition"/>
                    <field name="bin_type"/>
                    <field name="location"/>
                </tree>
            </field>
        </record>

        <!-- Form View for fleet.vehicle -->
        <record id="fleet_vehicle_form_zw_asset" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.zw_asset</field>
            <field name="model">fleet.vehicle</field>
            <field name="arch" type="xml">
                <form string="Zi-Waste Fleet">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="license_plate"/>
                            <field name="mass"/>
                        </group>
                        <notebook>
                            <page string="Inspections">
                                <field name="inspection_ids" widget="one2many_list">
                                    <tree>
                                        <field name="fault_status"/>
                                        <field name="comment"/>
                                        <field name="image" widget="image"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Vehicle Logs">
                                <field name="log_ids" widget="one2many_list">
                                    <tree>
                                        <field name="driver_id"/>
                                        <field name="load_count"/>
                                        <field name="date"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View for fleet.vehicle -->
        <record id="fleet_vehicle_tree_zw_asset" model="ir.ui.view">
            <field name="name">fleet.vehicle.tree.zw_asset</field>
            <field name="model">fleet.vehicle</field>
            <field name="arch" type="xml">
                <tree string="Zi-Waste Fleet">
                    <field name="name"/>
                    <field name="model_id"/>
                    <field name="license_plate"/>
                    <field name="mass"/>
                </tree>
            </field>
        </record>

        <!-- Search View for stock.quant -->
        <record id="stock_quant_search_zw_asset" model="ir.ui.view">
            <field name="name">stock.quant.search.zw_asset</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <search string="Zi-Waste Bins">
                    <field name="bin_number"/>
                    <field name="waste_type"/>
                    <field name="mine_id"/>
                    <filter string="Available" name="available" domain="[('product_id.is_asset', '=', True)]"/>
                </search>
            </field>
        </record>

        <!-- Action for Zi-Waste Bins -->
        <record id="action_zi_waste_bins" model="ir.actions.act_window">
            <field name="name">Zi-Waste Bins</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('product_id.is_asset', '=', True)]</field>
            <field name="context">{'search_default_available': 1}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Manage all Zi-Waste bins and containers
                </p>
            </field>
        </record>

        <!-- Action for Zi-Waste Fleet -->
        <record id="action_zi_waste_fleet" model="ir.actions.act_window">
            <field name="name">Zi-Waste Fleet</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_vehicle_type': 'truck'}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Manage all Zi-Waste vehicles and equipment
                </p>
            </field>
        </record>


        <menuitem id="menu_asset_management_root" name="Asset Management" sequence="60"/>
        <menuitem id="menu_bin_management" name="Bin Management" parent="menu_asset_management_root" action="action_zi_waste_bins" sequence="10"/>
        <menuitem id="menu_fleet_management" name="Fleet Management" parent="menu_asset_management_root" action="action_zi_waste_fleet" sequence="20"/>
    </data>
</odoo>
