<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_asset_management_root" name="Waste Asset Management" sequence="10"/>


    <record id="view_zw_bin_management_search" model="ir.ui.view">
        <field name="name">stock.quant.search.zw_asset</field>
        <field name="model">stock.quant</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search>
                <field name="bin_number"/>
                <field name="mine_id"/>
                <field name="condition"/>
                <field name="collected_bin"/>
                <filter name="available" string="Available" domain="[('collected_bin','=','draft')]"/>
                <filter name="in_use" string="In Use" domain="[('collected_bin','=','open')]"/>
                <filter name="collected" string="Collected" domain="[('collected_bin','=','done')]"/>
                <filter name="damaged" string="Damaged Bins" domain="[('condition','=','damaged')]"/>
                <separator/>
                <filter name="assigned" string="Assigned to Mine" domain="[('assign_to_mine','=',True)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('assign_to_mine','=',False)]"/>
                <filter name="by_mine" string="By Mine" context="{'group_by':'mine_id'}"/>
            </search>
        </field>
    </record>


    <record id="view_zw_bin_management_tree" model="ir.ui.view">
        <field name="name">stock.quant.tree.zw_asset</field>
        <field name="model">stock.quant</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree string="Bin Management" create="true" default_order="bin_number asc"
                  decoration-danger="condition in ['damaged']"
                  decoration-warning="condition in ['poor']"
                  decoration-success="collected_bin=='done'">
                <header>
                    <button name="action_assign_to_mine" string="Assign to Mine" type="object" class="btn-secondary"
                            attrs="{'invisible': [('assign_to_mine', '=', True)]}"/>
                </header>
                <field name="bin_number" string="Bin Number" width="150"/>
                <field name="bin_size" string="Bin Size" width="120"/>
                <field name="condition" string="Condition" width="120"/>
                <field name="collected_bin" string="Bin Status" width="140"/>
                <field name="mine_id" string="Mine" width="150" invisible="1"/>
                <field name="display_location" string="Location" widget="char" width="200"/>
                <field name="assign_to_mine" invisible="1"/>
                <field name="location_id" invisible="1"/>
            </tree>
        </field>
    </record>


    <record id="view_stock_quant_form_zw_asset" model="ir.ui.view">
        <field name="name">stock.quant.form.zw_asset</field>
        <field name="model">stock.quant</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Zi-Waste Bin">
                <header>
                    <button name="action_assign_to_mine" string="Assign to Mine" type="object" class="btn-primary"
                            attrs="{'invisible': [('assign_to_mine', '=', True)]}"/>
                    <button name="action_delete_damaged" string="Delete Damaged" type="object" class="btn-danger"
                            attrs="{'invisible': [('condition', '!=', 'damaged')]}"/>
                    <button string="Save" special="save" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="bin_number"/></h1>
                    </div>
                    <group>
                        <group string="Bin Information">
                            <field name="product_id" domain="[('is_asset', '=', True)]" invisible="1"/>
                            <field name="bin_size" readonly="0" required="1"/>
                            <field name="bin_type" invisible="1"/>
                            <field name="condition" required="1"/>
                            <field name="collected_bin" required="1"/>
                            <field name="waste_type" attrs="{'invisible': [('assign_to_mine', '=', False)]}"/>
                            <field name="waste_description" attrs="{'invisible': [('assign_to_mine', '=', False)]}"/>
                            <field name="assign_to_mine"/>
                            <field name="available_location_ids" invisible="1"/>
                        </group>
                        <group string="Location Details">
                            <field name="mine_id" attrs="{'invisible': [('assign_to_mine', '=', False)]}"/>
                            <field name="collection_area_id" invisible="1"/>
                            <field name="location_id" required="1"
                                   attrs="{'readonly': [('assign_to_mine', '=', True)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Audit History">
                            <field name="audit_ids" mode="tree">
                                <tree>
                                    <field name="name"/>
                                    <field name="auditor_id"/>
                                    <field name="audit_date"/>
                                    <field name="condition"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Inspections">
                            <field name="inspection_ids" mode="tree">
                                <tree>
                                    <field name="fault_status"/>
                                    <field name="comment"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_zi_waste_bins" model="ir.actions.act_window">
        <field name="name">Bin Management</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_zw_bin_management_tree"/>
        <field name="search_view_id" ref="view_zw_bin_management_search"/>
        <field name="domain">[('product_id.is_asset', '=', True)]</field>
        <field name="context">
            {'search_default_available': 1,
             'default_condition': 'good',
             'default_collected_bin': 'draft',
             'default_assign_to_mine': False}
        </field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Click to add a new bin</p>
        </field>
    </record>


    <menuitem id="menu_bin_management" name="Bin Management" parent="menu_asset_management_root" action="action_zi_waste_bins" sequence="10"/>


    <record id="product_product_bin" model="product.product">
        <field name="name">Standard Bin</field>
        <field name="is_asset" eval="True"/>
        <field name="type">product</field>
        <field name="bin_size">6m3</field>
        <field name="categ_id" ref="product.product_category_all"/>
    </record>


    <record id="seq_stock_quant_bin_number" model="ir.sequence">
        <field name="name">Bin Number Sequence</field>
        <field name="code">stock.quant.bin.number</field>
        <field name="prefix">BIN/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>



    <record id="view_fleet_vehicle_form_zw_asset" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.zw_asset</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Zi-Waste Fleet</attribute>
            </xpath>
            <xpath expr="//field[@name='driver_id']" position="after">
                <field name="mass" class="oe_highlight"/>
                <field name="is_trailer"/>
                <field name="trailer_size" attrs="{'invisible': [('is_trailer', '=', False)]}"/>
                <field name="assistant_driver_id"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Inspections">
                    <field name="inspection_ids" mode="tree,form">
                        <tree>
                            <field name="fault_status"/>
                            <field name="comment"/>
                        </tree>
                        <form>
                            <group>
                                <field name="fault_status"/>
                                <field name="comment"/>
                                <field name="image" widget="image"/>
                            </group>
                        </form>
                    </field>
                </page>
                <page string="Vehicle Logs">
                    <field name="log_ids" mode="tree,form">
                        <tree>
                            <field name="driver_id"/>
                            <field name="date"/>
                            <field name="load_count"/>
                        </tree>
                        <form>
                            <group>
                                <field name="driver_id"/>
                                <field name="assistant_driver_id"/>
                                <field name="date"/>
                                <field name="load_count"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_vehicle_tree_zw_asset" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.zw_asset</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="string">Zi-Waste Fleet</attribute>
                <attribute name="class">oe_list_view</attribute>
            </xpath>
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="is_trailer" class="oe_list_field"/>
                <field name="trailer_size" class="oe_list_field"/>
                <field name="driver_id" class="oe_list_field"/>
                <field name="assistant_driver_id" class="oe_list_field"/>
            </xpath>
        </field>
    </record>

    <record id="action_zi_waste_fleet" model="ir.actions.act_window">
        <field name="name">Zi-Waste Fleet</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_vehicle_type': 'truck'}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Create a new vehicle record</p>
        </field>
    </record>

    <menuitem id="menu_fleet_management" name="Fleet Management" parent="menu_asset_management_root" action="action_zi_waste_fleet" sequence="20"/>
</odoo>