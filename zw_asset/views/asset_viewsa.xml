<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_quant_form_zw_asset" model="ir.ui.view">
        <field name="name">stock.quant.form.zw_asset</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Zi-Waste Bin Details">
                    <field name="bin_number"/>
                    <field name="waste_type"/>
                    <field name="waste_description"/>
                    <field name="mine_id"/>
                    <field name="condition"/>
                    <field name="bin_type"/>
                    <field name="location"/>
                    <field name="audit_ids"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_fleet_vehicle_form_zw_asset" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.zw_asset</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Zi-Waste Vehicle Details">
                    <field name="mass"/>
                    <field name="inspection_ids"/>
                    <field name="log_ids"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>