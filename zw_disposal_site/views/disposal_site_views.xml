<odoo>
    <data>
        <record id="zw_disposal_site.disposal_site_form" model="ir.ui.view">
            <field name="name">disposal.site.form</field>
            <field name="model">disposal.site</field>
            <field name="arch" type="xml">
                <form string="Disposal Site">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="address"/>
                            <field name="postal_code"/>
                            <field name="contact_number"/>
                            <field name="fax"/>
                            <field name="sawis_number"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="zw_disposal_site.disposal_site_tree" model="ir.ui.view">
            <field name="name">disposal.site.tree</field>
            <field name="model">disposal.site</field>
            <field name="arch" type="xml">
                <tree string="Disposal Sites">
                    <field name="name"/>
                    <field name="sawis_number"/>
                </tree>
            </field>
        </record>

        <record id="zw_disposal_site.action_disposal_sites" model="ir.actions.act_window">
            <field name="name">Disposal Sites</field>
            <field name="res_model">disposal.site</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create your disposal site</p>
            </field>
        </record>

        <menuitem id="zw_disposal_site.menu_disposal_sites" name="Disposal Sites" action="zw_disposal_site.action_disposal_sites"/>
    </data>
</odoo>