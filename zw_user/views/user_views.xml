<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="view_users_form_zw_user" model="ir.ui.view">
            <field name="name">res.users.form.zw_user</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="Zi-Waste User Details">
                        <field name="custom_role"/>
                    </group>
                </xpath>
            </field>
        </record>
        <record id="view_users_tree_zw_user" model="ir.ui.view">
            <field name="name">res.users.tree.zw_user</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="custom_role"/>
                </tree>
            </field>
        </record>
        <record id="view_users_search_zw_user" model="ir.ui.view">
            <field name="name">res.users.search.zw_user</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="email"/>
                    <filter string="Depot Admins" name="depot_admins" domain="[('groups_id', 'in', [ref('zw_user.group_depot_admin')])]"/>
                </search>
            </field>
        </record>

        <record id="action_zw_users" model="ir.actions.act_window">
            <field name="name">Zi-Waste Users</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': False}</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Manage Zi-Waste system users and their roles</p>
            </field>
        </record>

        <menuitem id="menu_zw_user_root" name="Zi-Waste User Management" sequence="100" groups="zw_user.group_depot_admin"/>
        <menuitem id="menu_zw_user_users" name="Zi-Waste Users" parent="menu_zw_user_root" action="action_zw_users" groups="zw_user.group_depot_admin" sequence="10"/>
    </data>
</odoo>