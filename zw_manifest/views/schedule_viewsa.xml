<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_waste_schedule_form" model="ir.ui.view">
        <field name="name">waste.schedule.form</field>
        <field name="model">waste.schedule</field>
        <field name="arch" type="xml">
            <form string="Waste Schedule">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="customer_id"/>
                        <field name="mine_id"/>
                        <field name="waste_type_id"/>
                        <field name="scheduled_date"/>
                        <field name="status"/>
                        <field name="manifest_id"/>
                        <field name="notes"/>
                    </group>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" attrs="{'invisible': [('status', '!=', 'pending')]}"/>
                </sheet>
            </form>
        </field>
        </record>
        <record id="view_waste_schedule_tree" model="ir.ui.view">
            <field name="name">waste.schedule.tree</field>
            <field name="model">waste.schedule</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="scheduled_date"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>
</odoo>