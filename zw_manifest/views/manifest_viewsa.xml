<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_manifest_form" model="ir.ui.view">
        <field name="name">waste.manifest.form</field>
        <field name="model">waste.manifest</field>
        <field name="arch" type="xml">
            <form string="Waste Manifest">
                <sheet>
                    <group>
                        <field name="manifest_id"/>
                        <field name="waste_type_id"/>
                        <field name="tonnage"/>
                        <field name="dt_number"/>
                        <field name="un_sin_code"/>
                        <field name="status"/>
                        <field name="customer_id"/>
                        <field name="mine_id"/>
                        <field name="disposal_site_id"/>
                        <field name="driver_id"/>
                        <field name="weighbridge_receipt"/>
                        <field name="safe_disposal_certificate"/>
                        <field name="signature_mine"/>
                        <field name="signature_driver"/>
                    </group>
                    <button name="action_advance_status" string="Advance Status" type="object" class="oe_highlight"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_manifest_tree" model="ir.ui.view">
        <field name="name">waste.manifest.tree</field>
        <field name="model">waste.manifest</field>
        <field name="arch" type="xml">
            <tree>
                <field name="manifest_id"/>
                <field name="waste_type_id"/>
                <field name="status"/>
                <field name="customer_id"/>
                <field name="mine_id"/>
            </tree>
        </field>
    </record>
</odoo>